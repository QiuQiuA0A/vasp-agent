# 复制此文件为 .env 并填入真实值

# 域名 — Caddy 会自动申请 Let's Encrypt HTTPS 证书
DOMAIN=vasp.example.com

# API Key — 生成方式: openssl rand -hex 16
VASP_API_KEY=change-me-to-a-random-hex-string

# POTCAR 赝势库在本机的路径
VASP_POTCAR_HOST=./potcar_library

# (可选) SLURM 集群参数
# VASP_SLURM_PARTITION=compute
# VASP_SLURM_NODES=1
# VASP_SLURM_NTASKS=32
# VASP_SLURM_WALLTIME=24:00:00
# VASP_SLURM_MODULE=vasp/6.4.3
